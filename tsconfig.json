{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./.tmp/ts",
    "paths": {
      "~/*": ["./src/assets/javascripts/*"]
    }
  },
  "include": [
    "src/assets/javascripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docsforge/templates"
  ]
}
