{
  "name": "vscode-docsforge",
  "displayName": "DocsForge",
  "description": "Write and preview DocsForge documentation inside VS Code",
  "version": "12.4.0",
  "publisher": "QQSHI",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "docsforge",
    "documentation",
    "markdown",
    "mkdocs"
  ],
  "activationEvents": [
    "onCommand:docsforge.init",
    "onCommand:docsforge.serve",
    "onCommand:docsforge.stop",
    "onCommand:docsforge.build",
    "onCommand:docsforge.openServer",
    "onCommand:docsforge.openDocs",
    "onCommand:docsforge.stopBuild",
    "onCommand:docsforge.openLog",
    "onCommand:docsforge.setupEnvironment",
    "onCommand:docsforge.renameDocument",
    "onCommand:docsforge.renameAnchor",
    "onCommand:docsforge.refreshDiagnostics",
    "onView:docsforge.sidebar",
    "workspaceContains:docsforge.yml",
    "workspaceContains:mkdocs.yml",
    "workspaceContains:docsforge.yaml",
    "workspaceContains:mkdocs.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docsforge.init",
        "title": "Initialize Project",
        "icon": "$(new-folder)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.serve",
        "title": "Start Server",
        "icon": "$(play)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.stop",
        "title": "Stop Server",
        "icon": "$(debug-stop)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.build",
        "title": "Build",
        "icon": "$(gear)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.openServer",
        "title": "Open Preview",
        "icon": "$(globe)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.refreshSidebar",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.openDocs",
        "title": "Open Docs",
        "icon": "$(preview)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.stopBuild",
        "title": "Stop Build",
        "icon": "$(debug-stop)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.openLog",
        "title": "Open Output",
        "icon": "$(output)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.setupEnvironment",
        "title": "Check Python Environment",
        "icon": "$(tools)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.renameDocument",
        "title": "Rename Document",
        "icon": "$(symbol-rename)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.renameAnchor",
        "title": "Rename Anchor",
        "icon": "$(symbol-rename)",
        "category": "DocsForge"
      },
      {
        "command": "docsforge.refreshDiagnostics",
        "title": "Refresh Diagnostics",
        "icon": "$(refresh)",
        "category": "DocsForge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docsforge",
          "title": "DocsForge",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "docsforge": [
        {
          "id": "docsforge.sidebar",
          "name": "Actions",
          "when": "workspaceFolderCount >= 1"
        },
        {
          "id": "docsforge.output",
          "name": "Output",
          "type": "webview",
          "when": "workspaceFolderCount >= 1"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "docsforge.refreshSidebar",
          "group": "navigation",
          "when": "view == docsforge.sidebar"
        }
      ],
      "view/item/context": []
    },
    "configuration": {
      "title": "DocsForge",
      "properties": {
        "docsforge.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter path"
        },
        "docsforge.lan": {
          "type": "boolean",
          "default": false,
          "description": "Serve on all interfaces (0.0.0.0) instead of localhost only. Equivalent to docsforge serve --lan."
        },
        "docsforge.openBrowser": {
          "type": "boolean",
          "default": true,
          "description": "Open the DocsForge site in VS Code's Simple Browser when the server detects its URL. The CLI always runs with --no-open so the extension manages browser access."
        },
        "docsforge.rememberedPython": {
          "type": "string",
          "default": "",
          "description": "Python interpreter the extension resolved (e.g. a project .venv). Managed automatically; set docsforge.pythonPath to override."
        }
      }
    },
    "keybindings": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "test": "mocha"
  },
  "mocha": {
    "require": [
      "ts-node/register"
    ],
    "spec": "test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "brace-expansion": ">=2.1.4",
    "diff": "^9.0.0",
    "glob": "^13.0.0",
    "serialize-javascript": "^7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/QQSHI13/docsforge",
    "directory": "vscode-docsforge"
  }
}
